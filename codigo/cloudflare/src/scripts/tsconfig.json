{
  // Código del navegador: tipos del DOM, sin los de Workers (chocan con Element de HTMLRewriter).
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": [], "allowImportingTsExtensions": true
  },
  "include": ["*.ts"]
}
