{
  "name": "@tablemaroc/cloudflare",
  "private": true,
  "type": "module",
  "description": "Tablemaroc en Cloudflare (maestro §18 ter): Astro en Workers, D1, R2, Cron Triggers y Turnstile. Sin plantillas visuales hasta que se apruebe el diseño (§19).",
  "scripts": {
    "dev": "node scripts/preparar-pwa.mjs && astro dev",
    "build": "node scripts/preparar-pwa.mjs && astro build",
    "preview": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply tablemaroc --local",
    "db:migrate:remote": "wrangler d1 migrations apply tablemaroc --remote",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.4",
    "@astrojs/preact": "6.1.1",
    "@fontsource-variable/literata": "5.3.0",
    "@simplewebauthn/server": "14.0.3",
    "astro": "7.4.5",
    "preact": "11.1.1"
  }
}
