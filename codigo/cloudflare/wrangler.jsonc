// Tablemaroc en Cloudflare (maestro §18 ter). Sin account_id ni secretos: el titular crea la cuenta y las claves (§2).
// Base D1 creada el 05-11-2026 con jurisdicción UE (los datos se guardan y procesan solo en la Unión Europea, RGPD).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tablemaroc",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,   // versión de prueba en *.workers.dev (sin indexar) hasta tener tablemaroc.com
  "observability": { "enabled": true },

  // Base de datos (D1, SQLite). Migraciones en ./migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tablemaroc",
      "database_id": "73af0f91-dfee-4cec-9c6d-b70263eb4a31",
      "migrations_dir": "./migrations"
    }
  ],

  // R2: fotos (públicas a través del Worker) y copias de seguridad (privadas, §9). Jurisdicción UE, como la base de datos.
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "tablemaroc-fotos", "jurisdiction": "eu" },
    { "binding": "COPIAS", "bucket_name": "tablemaroc-copias", "jurisdiction": "eu" }
  ],

  // Tareas programadas (§6). Horas en UTC; Marruecos es UTC+1.
  "triggers": {
    "crons": [
      "0 7,13,19 * * *", // moderación de reseñas y fotos, 3 veces al día (08:00, 14:00 y 20:00 en Marruecos)
      "30 2 * * *",      // copia diaria de la base de datos a R2
      "0 3 * * 1",       // semanal: copia de fotos y configuración no secreta
      "0 4 1 * *"        // mensual: revisión de seguridad, duplicidad y SEO
    ]
  },

  // Variables NO secretas. Los secretos (Turnstile, email transaccional, Google OAuth) van con `wrangler secret put`.
  "vars": {
    "SITE_URL": "https://tablemaroc.com",
    "DEFAULT_LOCALE": "es",
    "ENTORNO": "prueba"          // "produccion" solo en tablemaroc.com: fuera de producción, noindex y robots.txt cerrado
  }
}
